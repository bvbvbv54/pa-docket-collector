DATABASE_URL=postgresql+psycopg://pa_docket:change-me@db:5432/pa_docket
POSTGRES_PASSWORD=change-me-to-a-long-random-password
STORAGE_DIR=./data
MAX_PDFS_PER_JOB=500
MAX_CONCURRENT_DOWNLOADS=3
MAX_PARSE_WORKERS=2
MAX_BROWSER_CONTEXTS=3
REQUESTS_PER_MINUTE=10
NETWORK_MODE=direct
PROXY_COUNTRY=US
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
# Sticky exit is mandatory: the portal signs document URLs to one exit IP.
# DataImpulse format: USERNAME__cr.us;sessid.padocket
LIVE_COLLECTION_ENABLED=false
LIVE_ACCESS_APPROVED=false
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=change-this-before-exposing-dashboard
SESSION_SECRET=generate-a-long-random-value-before-exposing-dashboard
PUBLIC_HOST=records.example.com

